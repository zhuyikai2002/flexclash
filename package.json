{
  "name": "flexclash",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:types": "vue-tsc --noEmit",
    "check:rust": "cd src-tauri && cargo check",
    "check": "vue-tsc --noEmit && npm run check:rust",
    "clean": "powershell -NoProfile -Command \"Get-Process flexclash,mihomo -ErrorAction SilentlyContinue | Where-Object { $_.Path -like '*flexclash*' -or $_.Name -eq 'flexclash' } | Stop-Process -Force\"",
    "reset-dev": "npm run clean && npm run dev",
    "ports": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 7890,7897,9091 -ErrorAction SilentlyContinue | Select-Object LocalAddress,LocalPort,State,OwningProcess\""
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.10.8",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.2",
    "@tauri-apps/plugin-http": "^2.0.1",
    "@tauri-apps/plugin-process": "^2.0.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@vueuse/core": "^12.0.0",
    "axios": "^1.7.9",
    "lucide-vue-next": "^0.469.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-i18n": "^11.4.10",
    "vue-tsc": "^2.1.10",
    "ws": "^8.21.3"
  }
}
