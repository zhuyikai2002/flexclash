{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlexClash",
  "version": "0.2.2",
  "identifier": "com.flexclash.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlexClash",
        "width": 1100,
        "height": 720,
        "label": "main",
        "transparent": true,
        "decorations": true,
        "shadow": true,
        "center": true,
        "minWidth": 880,
        "minHeight": 560,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zhuyikai2002/flexclash/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RkM2Q0UzQjEzOTZGMjIKUldRaWJ6bXg0Mno4cU1GOEQ0QnFpcEZ1SzRpcnBjSU93REJqUm52aldwazhQQW1pRjBJVVZTcmUK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mihomo"]
  }
}
