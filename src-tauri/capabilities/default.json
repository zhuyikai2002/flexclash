{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FlexClash default capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",

    "shell:default",
    "shell:allow-execute",

    "process:default",
    "process:allow-exit",

    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/*" },
        { "path": "$APPCONFIG/*" },
        { "path": "$APPLOCALDATA/*" }
      ]
    },

    "http:default",
    "dialog:default",

    "autostart:default"
  ]
}
