{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlexClash",
  "version": "0.1.1",
  "identifier": "com.flexclash.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlexClash",
        "width": 1100,
        "height": 720,
        "label": "main",
        "transparent": true,
        "decorations": true,
        "shadow": true,
        "center": true,
        "minWidth": 880,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mihomo"]
  }
}
