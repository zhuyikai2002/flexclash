# ============================================================================
# FlexClash .gitignore
# ----------------------------------------------------------------------------
# This is the source of truth for what NOT to commit. Keep it tight; anything
# that ends up in `git push` will live in the repo forever.
# ============================================================================

# ----------------------------------------------------------------------------
# Node / Vite frontend
# ----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
.npm/
.eslintcache
.stylelintcache

# ----------------------------------------------------------------------------
# Rust / Cargo / Tauri
# ----------------------------------------------------------------------------
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/

# Sidecar binaries (DO NOT commit the 50MB mihomo.exe — it's a redistributable
# downloaded from https://github.com/MetaCubeX/mihomo/releases; the .gitkeep
# preserves the folder for local builds).
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# Cross-platform icon sets generated by `npx tauri icon` but not used by
# the current Windows-only build. Re-generate with:
#   npx @tauri-apps/cli icon src-tauri/icons/app-icon.svg
src-tauri/icons/ios/
src-tauri/icons/android/
src-tauri/icons/icon.icns
src-tauri/icons/icon.png
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png
src-tauri/icons/64x64.png

# ----------------------------------------------------------------------------
# Editors / OS junk
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.vscode-test/
*.swp
*.swo
*~

# ----------------------------------------------------------------------------
# Runtime data (created at first launch under %LOCALAPPDATA%\com.flexclash.app\)
# ----------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm

# ----------------------------------------------------------------------------
# Release artifacts (kept locally for manual upload, never committed)
# ----------------------------------------------------------------------------
release-artifacts/
*.exe.bak

# ----------------------------------------------------------------------------
# Logs & temporary test artifacts
# ----------------------------------------------------------------------------
*.log
verify-m*.log
verify-m*.ps1
verify-m*.txt
mihomo-stdout.log
mihomo-stderr.log
cargo-check.log
npm-install.log
build.log

# Maintainer-only documents (kept locally, not for contributors)
ENGINEERING-CLOSEOUT.md
PUBLISH-TO-GITHUB.md
RELEASE-NOTES-*.md

# Stale verify-script probe helpers (left in repo root from past test runs)
m3-traffic-probe.cjs
m8-traffic-gen.cjs
configs.raw.json
verify-m1.v2.ps1

# PowerShell transient files
*.tmp

# ----------------------------------------------------------------------------
# Secrets & local config
# ----------------------------------------------------------------------------
.env
.env.local
.env.*.local
secrets/
*.key
*.pem
*.pfx
*.p12
